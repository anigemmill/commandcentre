# Copy to .env.local for local development. Never commit real values.
# Local database (npm run setup prints the same URL):
DATABASE_URL=postgres://postgres@localhost:54330/commandcentre
# Public URL of this app.
APP_URL=http://localhost:3000
# Development sign-in (no passwords; choose a seeded test person). Refused in production and on any
# non-localhost APP_URL. Replaced by the account service's OAuth sign-in (docs/mvp-auth.md).
DEV_IDENTITY=enabled
# Shared sign-in with the Outside In account service (all three or none; required in production).
# accounts-dev: issuer below; client id and secret from the OAuth app "Command Centre (local development)".
ACCOUNTS_ISSUER=https://urdrrzqqtmeuwlxksuov.supabase.co/auth/v1
ACCOUNTS_CLIENT_ID=
ACCOUNTS_CLIENT_SECRET=
